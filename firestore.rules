rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // =============================================================
    // REMOVED OVERLY PERMISSIVE GLOBAL RULE FOR SECURITY
    // Previously allowed any authenticated user to access all documents
    // Now relying on granular collection-specific rules for proper security
    // =============================================================

    
    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isAdmin() {
      return isSignedIn() && 
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }
    
    function isOwnerOrAdmin(userId) {
      return isOwner(userId) || isAdmin();
    }

    function clientProfileUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'name', 'phone', 'company', 'address', 'bio',
        'preferredLanguage', 'notificationPreferences', 'updatedAt'
      ]);
    }

    function clientProjectUpdateOnly() {
      return request.resource.data.diff(resource.data).affectedKeys().hasOnly([
        'transcript', 'timestampedTranscript', 'speakerNames',
        'timestampFrequency', 'transcriptStyleId',
        'clientName', 'projectName', 'providerName', 'patientName',
        'location', 'recordingTime', 'specialInstructions',
        'projectDictionaryTerms', 'includeFiller', 'expectedSpeakerCount',
        'isShared', 'shareId', 'sharedAt',
        'deletionRequested', 'deletionRequestedAt', 'deletionRequestedBy',
        'deletionRequestStatus', 'deletionRequestNote', 'updatedAt'
      ]);
    }

    function validClientDeletionRequest() {
      return !request.resource.data.diff(resource.data).affectedKeys().hasAny([
               'deletionRequested', 'deletionRequestedAt', 'deletionRequestedBy',
               'deletionRequestStatus', 'deletionRequestNote'
             ]) ||
             (request.resource.data.deletionRequested == true &&
              request.resource.data.deletionRequestedBy == request.auth.uid &&
              request.resource.data.deletionRequestStatus == 'requested');
    }

    // Users collection
    match /users/{userId} {
      // Users can read their own profile, admins can read all profiles
      allow read: if isOwnerOrAdmin(userId);

      // Profiles and initial entitlements are created by the authenticated
      // server initialization route. Admin SDK writes bypass these rules.
      allow create: if isAdmin();

      // Owners may update only ordinary profile preferences. Financial,
      // entitlement, role, suspension, and Stripe fields remain server-owned.
      allow update: if (isSignedIn() && isOwner(userId) && clientProfileUpdateOnly()) || isAdmin();

      // Only admins can delete user profiles
      allow delete: if isAdmin();

      // User packages subcollection (minute packages purchased by user)
      match /packages/{packageId} {
        // Users can read their own packages, admins can read any user's packages
        allow read: if isOwnerOrAdmin(userId);

        // Package entitlements are written only by admins or trusted server code.
        allow create, update, delete: if isAdmin();
      }

      // Private reusable dictionary terms saved by the user for future jobs
      match /clientDictionaryTerms/{termId} {
        allow read, create, update, delete: if isOwnerOrAdmin(userId);
      }
    }

    // Transcriptions collection
    match /transcriptions/{transcriptionId} {
      // Users can read their own transcriptions, admins can read all transcriptions
      // Shared transcriptions can be read by anyone (even unauthenticated)
      allow read: if (resource.data.isShared == true) ||
                     (isSignedIn() &&
                      (resource.data.userId == request.auth.uid || isAdmin()));

      // Project creation is handled by authenticated server routes.
      allow create: if isAdmin();

      // Owners may edit transcript content and explicitly client-owned metadata.
      // All workflow, billing, quote, delivery, assignment, and audit state is
      // omitted from this allowlist and can only be written by admin/server code.
      allow update: if isAdmin() ||
                       (isSignedIn() && resource.data.userId == request.auth.uid &&
                        clientProjectUpdateOnly() && validClientDeletionRequest());

      // Client deletion uses the reviewed deletion-request workflow.
      allow delete: if isAdmin();

      match /quoteAdminSnapshots/{quoteId} {
        allow read: if isAdmin();
        allow write: if false;
      }

      match /auditEvents/{eventId} {
        allow read: if isAdmin();
        allow write: if false;
      }
    }

    // Credits collection
    match /credits/{userId} {
      // Users can read their own credits, admins can read all credits
      allow read: if isOwnerOrAdmin(userId);
      
      // Legacy account credit is a financial entitlement.
      allow create, update, delete: if isAdmin();
    }

    // Transactions collection
    match /transactions/{transactionId} {
      // Users can read their own transactions, admins can read all transactions
      allow read: if isSignedIn() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Financial records are written only by admins or trusted server code.
      allow create: if isAdmin();
      
      // Only admins can update transactions
      allow update: if isAdmin();
      
      // Only admins can delete transactions
      allow delete: if isAdmin();
    }

    // Queue collection (for transcription processing)
    match /queue/{jobId} {
      // Users can read their own queue items, admins can read all
      allow read: if isSignedIn() && 
                     (resource.data.userId == request.auth.uid || isAdmin());
      
      // Queue workflow is maintained by trusted server/admin code.
      allow create, update, delete: if isAdmin();
    }

    // Usage records collection
    match /usage/{recordId} {
      // Users can read their own usage, admins can read all usage
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    // Usage records collection (detailed subscription usage tracking)
    match /usageRecords/{recordId} {
      // Users can read their own usage records, admins can read all
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      allow create, update, delete: if isAdmin();
    }

    // Subscriptions collection
    match /subscriptions/{subscriptionId} {
      // Users can read their own subscription, admins can read all subscriptions
      allow read: if isSignedIn() &&
                     (resource.data.userId == request.auth.uid || isAdmin());

      // Stripe subscription state is written only by trusted server/admin code.
      allow create, update, delete: if isAdmin();
    }

    // Subscription events collection (webhook processing)
    match /subscriptionEvents/{eventId} {
      // Only admins can read events
      allow read: if isAdmin();

      // Server Admin SDK handles webhook writes and bypasses client rules.
      allow create, update: if false;

      // Only admins can delete events
      allow delete: if isAdmin();
    }

    // Settings/configuration
    match /settings/{settingId} {
      // Anyone can read settings (needed for public pricing display)
      allow read: if true;

      // Only admins can write/update settings
      allow write: if isAdmin();
    }

    // Packages collection (for pricing tiers and minute bundles)
    match /packages/{packageId} {
      // Anyone can read packages (needed for public pricing page)
      allow read: if true;

      // Only admins can create, update, or delete packages
      allow create, update, delete: if isAdmin();
    }

    // Webhook events collection (idempotency tracking)
    match /_webhook_events/{eventId} {
      // Server Admin SDK handles webhook idempotency and bypasses client rules.
      allow create, update: if false;
      allow read: if isAdmin();

      // Only admins can delete
      allow delete: if isAdmin();
    }

    // Failed payments collection (for admin review)
    match /failed_payments/{paymentId} {
      // Server Admin SDK records failed payments and bypasses client rules.
      allow create, update: if false;

      // Only admins can read/delete
      allow read, delete: if isAdmin();
    }

    // Remove the overly permissive demo rule - demo users should follow same rules
    // Demo users are identified by email in other rules, not by bypassing security
  }
}
